# Postman API Configuration
# 获取您的 Postman API 密钥: https://web.postman.co/settings/me/api-keys
POSTMAN_API_KEY=your_postman_api_key_here

# 场景服务器：与 y1-p 同在 proxy 网络时，通过 Docker 服务名直连（B0/B1 均可用）。
SCENE_SERVER_BASE_URL=http://y1-p:8080/
# PHP 会自动拼接 /v1/server。
# 如果不在同一 Docker 网络，再使用对应的 HTTPS 域名：
# B0： https://y1.b0.01xr.com
# B1： https://y1.b1.01xr.com
# 开发 B0： https://y1.d.b0.01xr.com
# 开发 B1： https://y1.d.b1.01xr.com

# 其他环境变量可以在这里添加
