# FRONTEND_HTTP_CONFIG
# MINIPROGRAM_HTTP_CONFIG

server {
    listen 80;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 64k;

    # Only the existing Traefik instance can supply the client's address.
    set_real_ip_from 172.18.0.2;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;

    proxy_http_version 1.1;
    proxy_connect_timeout 5s;
    proxy_send_timeout 20s;
    proxy_read_timeout 20s;
    proxy_next_upstream off;
    proxy_intercept_errors off;
    proxy_cache off;
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # FRONTEND_RUNTIME_CONFIG

    # MINIPROGRAM_ROUTES

    # FRONTEND_BACKEND_ROUTES

    # Neither arbitrary backend routes nor original server sources are public.
    location /backends/ { return 404; }
    location ~ (^|/)\. { return 404; }
    location ~* \.(php|phar|phtml|ini|log|sql|env|map)$ { return 404; }
    location = / {
        add_header Cache-Control no-cache always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        add_header X-Frame-Options DENY always;
        try_files /index.html =404;
    }
    location = /index.html {
        add_header Cache-Control no-cache always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        add_header X-Frame-Options DENY always;
        try_files $uri =404;
    }
    location / { try_files $uri =404; }
}
