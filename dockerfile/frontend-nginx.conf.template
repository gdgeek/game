server {
    listen 80;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 64k;

    # Only the existing Traefik instance can supply the client's address.
    set_real_ip_from 172.18.0.2;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;

    proxy_http_version 1.1;
    proxy_connect_timeout 5s;
    proxy_send_timeout 20s;
    proxy_read_timeout 20s;
    proxy_next_upstream off;
    proxy_intercept_errors off;
    proxy_cache off;
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ^~ /backends/b0/admin-api/ {
        proxy_pass ${APP_API_1_ORIGIN}/admin-api/;
        proxy_set_header Host ${APP_API_1_HOST};
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_ssl_name ${APP_API_1_TLS_NAME};
        proxy_cookie_path ~^/.*$ /backends/b0/;
        proxy_cookie_domain ~. $host;
        proxy_cookie_flags ~ secure httponly samesite=lax;
        proxy_redirect ${APP_API_1_ORIGIN}/admin-api/ /backends/b0/admin-api/;
    }

    location ^~ /backends/b1/admin-api/ {
        proxy_pass ${APP_API_2_ORIGIN}/admin-api/;
        proxy_set_header Host ${APP_API_2_HOST};
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_ssl_name ${APP_API_2_TLS_NAME};
        proxy_cookie_path ~^/.*$ /backends/b1/;
        proxy_cookie_domain ~. $host;
        proxy_cookie_flags ~ secure httponly samesite=lax;
        proxy_redirect ${APP_API_2_ORIGIN}/admin-api/ /backends/b1/admin-api/;
    }

    # Health probes never carry a login cookie, authorization or write body.
    location = /backends/b0/health {
        limit_except GET { deny all; }
        set $args "";
        proxy_pass ${APP_API_1_ORIGIN}/health;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header Host ${APP_API_1_HOST};
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_ssl_name ${APP_API_1_TLS_NAME};
        proxy_hide_header Set-Cookie;
    }

    location = /backends/b1/health {
        limit_except GET { deny all; }
        set $args "";
        proxy_pass ${APP_API_2_ORIGIN}/health;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header Host ${APP_API_2_HOST};
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_ssl_name ${APP_API_2_TLS_NAME};
        proxy_hide_header Set-Cookie;
    }

    # Neither arbitrary backend routes nor original server sources are public.
    location /backends/ { return 404; }
    location ~ (^|/)\. { return 404; }
    location ~* \.(php|phar|phtml|ini|log|sql|env|map)$ { return 404; }
    location = / { try_files /index.html =404; }
    location / { try_files $uri =404; }
}
