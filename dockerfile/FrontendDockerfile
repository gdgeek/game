FROM nginx:1.28-alpine

RUN apk add --no-cache ca-certificates \
    && rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

COPY frontend/dist/ /usr/share/nginx/html/
COPY dockerfile/frontend-nginx.conf.template /etc/nginx/frontend-nginx.conf.template
COPY dockerfile/40-configure-frontends.sh /docker-entrypoint.d/40-configure-frontends.sh
COPY dockerfile/50-configure-miniprogram.sh /docker-entrypoint.d/50-configure-miniprogram.sh

RUN chmod +x /docker-entrypoint.d/40-configure-frontends.sh /docker-entrypoint.d/50-configure-miniprogram.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget -q -T 5 -O /dev/null http://127.0.0.1/healthz || exit 1
